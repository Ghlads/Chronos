.unity-button.generate-button {
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(21, 199, 42);
    border-left-color: rgb(22, 157, 38);
    border-right-color: rgb(22, 157, 38);
    border-top-color: rgb(22, 157, 38);
    border-bottom-color: rgb(2, 105, 14);
    transition-duration: 0.1s;
    transition-timing-function: ease-in;
}

.unity-button.generate-button:hover {
    scale: 1.02 1.02;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.unity-button.generate-button:active {
    scale: 1.01 1.02;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    background-color: rgb(69, 249, 90);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.readonly>ListView #unity-list-view__size-field{
    display: None;
}

.readonly>ListView #unity-list-view__footer{
    display: None;
}
