<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Framework/Script/Core/Editor/ScriptingAction/ActionSelector/ActionSelectorWindow.uss?fileID=7433441132597879392&amp;guid=af397f521098e5d4d99bf45837878e65&amp;type=3#ActionSelectorWindow" />
    <editor:ToolbarSearchField tooltip="filter function by name" style="width: auto;" />
    <engine:ListView allow-remove="false" allow-add="false" show-add-remove-footer="false" show-foldout-header="false" show-border="true" virtualization-method="FixedHeight" show-bound-collection-size="false" style="flex-grow: 1;" />
    <engine:VisualElement name="footer" style="justify-content: space-between; flex-direction: row; flex-shrink: 0;">
