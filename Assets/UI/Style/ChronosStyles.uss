.compass-needle {
    background-image: url("project://database/Assets/Art/CompassArrow.png?fileID=2636546667915235586&guid=8a6e33c18e1a51e4597f8b0cf0b5a2de&type=3#CompassArrowStraight");
    flex-shrink: 0;
    flex-grow: 1;
}

.compass {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.minimap {
    flex-shrink: 0;
    flex-grow: 0;
    width: 32px;
    height: 32px;
}

.minimap-marker {
    width: 4px;
    height: 4px;
    position: absolute;
    translate: -50% -50%;
    top: 50%;
    left: 50%;
}

.island {
    background-color: rgb(255, 193, 1);
}
