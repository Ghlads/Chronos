.compass-needle {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1254843080&guid=93245fbf45618e64eaa866b7737bce64&type=3#Needle");
    flex-shrink: 0;
    flex-grow: 1;
}

.compass {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1386249586&guid=93245fbf45618e64eaa866b7737bce64&type=3#Compass");
}

.minimap {
    flex-shrink: 0;
    flex-grow: 0;
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1962010746&guid=93245fbf45618e64eaa866b7737bce64&type=3#MapBacking");
}

.minimap-marker {
    width: 8px;
    height: 8px;
    position: absolute;
    translate: -50% -50%;
    top: 50%;
    left: 50%;
}

.island {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1298971352&guid=93245fbf45618e64eaa866b7737bce64&type=3#IslandIcon");
}

.unity-text-element {
    -unity-font-definition: url("project://database/Assets/Art/Font/PublicPixel.ttf?fileID=12800000&guid=a4771633cc86d9040ba8d81c01c6c695&type=3#PublicPixel");
    font-size: 4px;
    color: rgb(246, 239, 244);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: upper-left;
}

.info-title {
    font-size: 3px;
}

.unity-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 1px;
    padding-bottom: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=957060315&guid=93245fbf45618e64eaa866b7737bce64&type=3#Button");
    background-color: rgba(255, 255, 255, 0);
    transition-duration: 0.2s;
}

.unity-scroll-view__vertical-scroller {
}

.chronos-list-view .unity-scroller__slider {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    width: 4px;
    min-width: 4px;
}

.chronos-list-view Scroller {
    width: 4px;
}

.chronos-list-view .unity-base-slider__dragger {
    width: 2px;
    left: 1px;
    top: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.back-button {
    font-size: 8px;
    transition-duration: 0.5s;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1197370736&guid=93245fbf45618e64eaa866b7737bce64&type=3#BackButton");
    align-items: center;
    justify-content: center;
}

.unity-button.back-button:hover {
    translate: 2px 0;
    transition-duration: 0.2s;
    background-color: rgba(0, 0, 0, 0);
}

.unity-button.back-button:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.1s;
    translate: 1px 0;
}

.trailer-button {
    width: 12px;
    height: 12px;
    transition-duration: 0.5s;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
}

.horizontal-separator {
    flex-shrink: 0;
    height: 8px;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=322164677&guid=93245fbf45618e64eaa866b7737bce64&type=3#ChronosSpriteSheet_0");
}

.unity-button.trailer-button:hover {
    translate: 2px 0;
    transition-duration: 0.2s;
    background-color: rgba(0, 0, 0, 0);
}

.chronos-list-view .unity-repeat-button {
    display: none;
    width: 4px;
}

.unity-button.trailer-button:active {
    translate: 1px 0;
    transition-duration: 0.1s;
    background-color: rgba(0, 0, 0, 0);
}

.unity-slider {
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    min-height: 8px;
}

.unity-slider #unity-drag-container {
    justify-content: center;
}

.unity-slider #unity-tracker {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    margin: 0;
    height: auto;
    flex-grow: 0;
    align-self: auto;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1180585268&guid=93245fbf45618e64eaa866b7737bce64&type=3#Rope");
    min-height: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-slider #unity-dragger {
    top: auto;
    width: 8px;
    height: 8px;
    margin: -1px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1196494765&guid=93245fbf45618e64eaa866b7737bce64&type=3#knot");
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.unity-slider__label {
    -unity-text-align: middle-center;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 40px;
    margin-right: 3px;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1269712643&guid=93245fbf45618e64eaa866b7737bce64&type=3#LabelBacker");
    padding-top: 2px;
    padding-right: 4px;
    padding-bottom: 3px;
    padding-left: 4px;
}

.chronos-slider {
}

.project-card {
    white-space: normal;
    align-items: flex-start;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 2px;
    padding-right: 4px;
    padding-bottom: 3px;
    padding-left: 4px;
}

.project-card .unity-button__image {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 16px;
    height: 16px;
}

.project-card .unity-text-element {
    -unity-text-align: middle-center;
    flex-grow: 1;
    align-self: center;
}

.chronos-button.unity-button:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.2s;
    translate: 2px 0;
}

.chronos-button.unity-button:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.1s;
    translate: 1px 0;
}

.back-button-text {
    font-size: 8px;
    margin-left: 4px;
}

.settings-options-container {
    justify-content: space-evenly;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1356228504&guid=93245fbf45618e64eaa866b7737bce64&type=3#Container");
    margin-top: 20px;
    margin-right: 3px;
    margin-bottom: 5px;
    margin-left: 3px;
    width: 50%;
    padding-left: 5px;
    padding-right: 5px;
    align-self: center;
    padding-top: 5px;
    padding-bottom: 5px;
    min-height: 85px;
    max-width: 50%;
}

.unity-base-slider--vertical #unity-dragger {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=813479799&guid=93245fbf45618e64eaa866b7737bce64&type=3#Anchor");
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    max-height: 16px;
    left: -100%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    position: absolute;
    top: 0;
}

.text-with-backing {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1269712643&guid=93245fbf45618e64eaa866b7737bce64&type=3#LabelBacker");
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 3px;
    padding-left: 6px;
    -unity-text-align: middle-center;
}

.chronos-list-view .unity-scroller__slider {
    overflow: visible;
}

.chronos-list-view .unity-scroll-view__horizontal-scroller {
    display: none;
    width: 8px;
}

.chronos-list-view .unity-collection-view__item:hover {
    background-color: rgba(0, 0, 0, 0);
}

.chronos-list-view .unity-scroll-view__vertical-scroller {
    display: none;
    width: 8px;
}

.chronos-list-view .unity-base-slider--vertical .unity-base-slider__tracker#unity-tracker {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1650174205&guid=93245fbf45618e64eaa866b7737bce64&type=3#Chain");
    background-repeat: repeat repeat;
    flex-grow: 1;
    width: 8px;
    background-size: 8px 16px;
    margin-top: 4px;
}

.chronos-list-view .unity-list-view__item:checked {
    background-color: rgba(0, 0, 0, 0);
}

.chronos-list-view.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: rgba(0, 0, 0, 0);
}

.bullet-point-list {
    max-height: none;
    min-height: auto;
    padding-top: 0;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    height: 45%;
    flex-shrink: 0;
}

.settings-islands-list {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1356228504&guid=93245fbf45618e64eaa866b7737bce64&type=3#Container");
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    width: 50%;
    max-width: 50%;
}

.trailer-button .unity-button__image {
    width: 8px;
    height: 8px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.project-details {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=-1356228504&guid=93245fbf45618e64eaa866b7737bce64&type=3#Container");
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.text-with-backing {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=1269712643&guid=93245fbf45618e64eaa866b7737bce64&type=3#LabelBacker");
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 3px;
    padding-left: 6px;
    -unity-text-align: middle-center;
}

.bullet-point {
    background-image: url("project://database/Assets/Art/ChronosSpriteSheet.png?fileID=957060315&guid=93245fbf45618e64eaa866b7737bce64&type=3#Button");
    margin-top: 2px;
    margin-bottom: 2px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 3px;
    padding-left: 2px;
}

.title {
    font-size: 8px;
    padding-right: 8px;
    padding-left: 8px;
}

.sub-title {
    font-size: 6px;
    padding-right: 6px;
    padding-left: 6px;
}

.bullet-point-list Scroller {
    translate: 4px 0;
}

.islands-list Scroller {
    translate: 1px 0;
}

.unity-base-field:focus:enabled > .unity-base-field__label {
    color: rgb(255, 255, 255);
}
